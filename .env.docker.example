# Copy to .env before running Docker Compose:
#   cp .env.docker.example .env

# Host port exposed by docker compose
HOST_PORT=5088

# Public URL shown in activation emails, payment callbacks and examples
DOMAIN=newapi.example.com
PUBLIC_BASE_URL=https://newapi.example.com

# Required: change before production
ADMIN_PASSWORD=change-this-admin-password
FLASK_SECRET_KEY=change-this-long-random-secret

# Runtime
MODEL_NAME=qwen2.5-coder-14b-ms:latest
# If Ollama runs on the Docker host:
OLLAMA_BASE_URL=http://host.docker.internal:11434
# If using docker-compose.ollama.yml sidecar, this is overridden to http://ollama:11434

# Gunicorn
GUNICORN_WORKERS=2
GUNICORN_TIMEOUT=300

# Optional EPay settings. Can also be configured in /admin.
EPAY_API_URL=
EPAY_PID=
EPAY_KEY=
