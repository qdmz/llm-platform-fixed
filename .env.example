# Runtime directory. Production default: /opt/llm-platform
LLM_PLATFORM_HOME=/opt/llm-platform

# HTTP service
PORT=5088
DOMAIN=newapi.example.com
PUBLIC_BASE_URL=https://newapi.example.com

# Flask/admin
FLASK_SECRET_KEY=change-me-to-a-long-random-secret
ADMIN_PASSWORD=change-me

# Local Ollama fallback/default model
OLLAMA_BASE_URL=http://127.0.0.1:11434
MODEL_NAME=qwen2.5-coder-14b-ms:latest

# Optional EPay settings. Can also be configured in /admin.
EPAY_API_URL=
EPAY_PID=
EPAY_KEY=
# 全站 HTTPS 时设为 1，会话 Cookie 仅通过 HTTPS 发送
SESSION_COOKIE_SECURE=0
# 同一 IP 10 分钟内允许的登录失败次数
LOGIN_MAX_FAILS=8
